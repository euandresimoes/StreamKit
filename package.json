{
  "name": "streamkit",
  "version": "0.0.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0 <11"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names frontend,backend,desktop --prefix-colors cyan,green,magenta \"pnpm dev:frontend\" \"pnpm dev:backend\" \"pnpm dev:desktop\"",
    "dev:frontend": "pnpm --filter @streamkit/frontend dev",
    "dev:backend": "pnpm --filter @streamkit/backend dev",
    "dev:desktop": "pnpm --filter @streamkit/desktop dev",
    "debug": "cross-env STREAMKIT_DEBUG=true pnpm dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "concurrently --kill-others-on-fail --names frontend,backend,desktop,contracts,config,test-utils --prefix-colors cyan,green,magenta,blue,yellow,gray \"pnpm test:frontend\" \"pnpm test:backend\" \"pnpm --filter @streamkit/desktop test\" \"pnpm --filter @streamkit/contracts test\" \"pnpm --filter @streamkit/config test\" \"pnpm --filter @streamkit/test-utils test\"",
    "test:frontend": "pnpm --filter @streamkit/frontend test",
    "test:backend": "pnpm --filter @streamkit/backend test",
    "test:integration": "pnpm --filter @streamkit/backend test:integration",
    "test:e2e": "pnpm --filter @streamkit/desktop test:e2e",
    "test:coverage": "concurrently --kill-others-on-fail --names frontend,backend --prefix-colors cyan,green \"pnpm --filter @streamkit/frontend test:coverage\" \"pnpm --filter @streamkit/backend test:coverage\"",
    "build": "pnpm -r --if-present build",
    "prod": "pnpm --filter @streamkit/desktop prod",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:integration && pnpm test:e2e && pnpm build",
    "release": "pnpm validate && pnpm --filter @streamkit/desktop release"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/jest": "29.5.14",
    "@types/node": "22.18.6",
    "concurrently": "10.0.4",
    "cross-env": "10.1.0",
    "eslint": "9.39.1",
    "eslint-plugin-vue": "10.10.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "prettier": "3.9.0",
    "ts-jest": "29.4.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vue-eslint-parser": "10.4.1"
  }
}
