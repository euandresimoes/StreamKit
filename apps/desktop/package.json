{
  "name": "@streamkit/desktop",
  "version": "0.0.0",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "dev": "wait-on http-get://127.0.0.1:5173 && cross-env STREAMKIT_RENDERER_URL=http://127.0.0.1:5173 electron-vite dev",
    "native:electron": "electron-builder install-app-deps",
    "native:node": "pnpm rebuild better-sqlite3",
    "postdev": "pnpm native:node",
    "postprod": "pnpm native:node",
    "predev": "pnpm native:electron",
    "preprod": "pnpm native:electron",
    "prod": "electron-vite preview",
    "release": "node scripts/release-not-configured.mjs",
    "test": "jest --config jest.config.cjs",
    "test:e2e": "jest --config jest.e2e.config.cjs",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit"
  },
  "dependencies": {
    "@renderizer/vue": "1.0.0-beta.0",
    "@streamkit/backend": "workspace:*",
    "@streamkit/config": "workspace:*",
    "@streamkit/contracts": "workspace:*",
    "better-sqlite3": "12.11.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@streamkit/test-utils": "workspace:*",
    "@vitejs/plugin-vue": "6.0.5",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "vite": "7.3.6",
    "vue-tsc": "3.3.9",
    "wait-on": "9.0.4"
  }
}
