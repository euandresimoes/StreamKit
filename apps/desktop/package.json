{
  "name": "@streamkit/desktop",
  "description": "Local-first desktop toolbox for streamers",
  "author": "André Simões",
  "version": "0.0.0",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "build": "electron-vite build && node scripts/assert-main-bundle.mjs",
    "dev": "wait-on http-get://127.0.0.1:5173 && cross-env STREAMKIT_RENDERER_URL=http://127.0.0.1:5173 electron-vite dev",
    "native:electron": "cd node_modules/better-sqlite3 && prebuild-install --runtime electron --target 39.8.10 --arch x64 --force",
    "native:node": "pnpm rebuild better-sqlite3",
    "postdev": "pnpm native:node",
    "postprod": "pnpm native:node",
    "predev": "pnpm native:electron",
    "preprod": "pnpm native:electron",
    "prod": "electron-vite preview",
    "package:win": "node scripts/package-windows.mjs",
    "release": "node scripts/assert-release-ready.mjs && pnpm package:win",
    "smoke:artifact": "node scripts/smoke-artifact.mjs",
    "test": "jest --config jest.config.cjs",
    "test:e2e": "jest --config jest.e2e.config.cjs",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit"
  },
  "dependencies": {
    "@renderizer/vue": "1.0.0-beta.0",
    "@streamkit/backend": "workspace:*",
    "@streamkit/config": "workspace:*",
    "@streamkit/contracts": "workspace:*",
    "better-sqlite3": "12.11.1",
    "electron-updater": "6.7.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@streamkit/test-utils": "workspace:*",
    "@vitejs/plugin-vue": "6.0.5",
    "electron": "39.8.10",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "prebuild-install": "7.1.3",
    "vite": "7.3.6",
    "vue-tsc": "3.3.9",
    "wait-on": "9.0.4"
  }
}
